# Copy to .env and fill in. .env is gitignored - never commit real secrets.

# billing-service database (used by docker-compose AND by billing-service)
BILLING_DB_USER=billing
BILLING_DB_PASSWORD=change-me
# billing-service reads this; default already points at the compose DB on localhost:5434
# BILLING_DB_URL=jdbc:postgresql://localhost:5434/billing

# billing-service -> Kafka (outbox relay). Default already points at the compose broker.
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# analytic-service database (its own Postgres on localhost:5433, not in compose yet)
ANALYTICS_DB_USER=admin_user
ANALYTICS_DB_PASSWORD=change-me
# ANALYTICS_DB_URL=jdbc:postgresql://localhost:5433/analytic-service-db

# payment-network-simulator (our fake acquirer, port 4010) and how billing-service talks to it
SIMULATOR_API_KEY=change-me-sim-key
SIMULATOR_WEBHOOK_SECRET=change-me-webhook-secret
# billing-service side: same values as above
GATEWAY_WEBHOOK_SECRET=change-me-webhook-secret
# BILLING_PROCESSOR=simulator          # or "fake" (in-memory, no simulator needed)
# SIMULATOR_URL=http://localhost:4010
# SIMULATOR_WEBHOOK_URL=http://localhost:4001/webhooks/gateway
# the simulator detokenizes billing's card token at card-vault (CARD_VAULT_KEY_SIMULATOR below) for the 0100;
# SIMULATOR_CARD_VAULT=http          # or "fake" (pm_card_* test tokens = the issuer's test cards; no vault needed)

# card-vault (port 4020) and its database (compose vault-db on localhost:5436). Generate real keys with:
#   openssl rand -base64 32
VAULT_DB_USER=vault
VAULT_DB_PASSWORD=change-me
# AES-256 data keys by version ("1:<base64 32 bytes>,2:<...>"); new cards use VAULT_ACTIVE_KEY_VERSION
VAULT_ENCRYPTION_KEYS=1:REPLACE_WITH_openssl_rand_base64_32
VAULT_ACTIVE_KEY_VERSION=1
VAULT_FINGERPRINT_KEY=REPLACE_WITH_openssl_rand_base64_32
# one API key per caller (>= 16 chars); each only allows that caller's job
CARD_VAULT_KEY_GATEWAY=change-me-gateway-key-tokenize
CARD_VAULT_KEY_BILLING=change-me-billing-key-metadata
CARD_VAULT_KEY_SIMULATOR=change-me-simulator-key-detokenize
# BILLING_CARD_VAULT=http              # or "fake" (any token is a test Visa; no vault needed)
# CARD_VAULT_URL=http://localhost:4020
